<Window x:Class="ONE200.Views.VoucherEntryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ONE200.ViewModels"
        mc:Ignorable="d"
        Title="Voucher Entry" Height="860" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:VoucherEntryViewModel />
    </Window.DataContext>

    <Window.Resources>

        <!-- Shared label style: right-aligned, vertically centred -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="#333333" />
        </Style>

        <!-- Standard input TextBox -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="22" />
            <Setter Property="BorderBrush" Value="#AAAAAA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Read-only TextBox -->
        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="#E8E8E8" />
        </Style>

        <!-- Standard ComboBox -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Toolbar button -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A6EA8" />
                    <Setter Property="BorderBrush" Value="#0D5A8E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Status bar button -->
        <Style x:Key="StatusBarButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#AAAAAA" />
        </Style>

        <!-- Filter panel section header -->
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#3A6EA8" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <!-- GroupBox section header override -->
        <Style x:Key="SectionGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#AAAAAA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar ribbon -->
            <RowDefinition Height="56" />
            <!-- Main content -->
            <RowDefinition Height="*" />
            <!-- Status bar -->
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             ROW 0 — Toolbar ribbon
        ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#2B5EA7">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <Button x:Name="NewButton"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding NewCommand}">
                    <StackPanel>
                        <TextBlock Text="&#x2795;" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding SaveCommand}">
                    <StackPanel>
                        <TextBlock Text="&#x1F4BE;" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding CopyCommand}">
                    <StackPanel>
                        <TextBlock Text="&#x1F4CB;" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding DeleteCommand}">
                    <StackPanel>
                        <TextBlock Text="&#x1F5D1;" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
                <Separator Background="#4A7EC0" Width="1" Margin="4,8" />
                <Button x:Name="FindButton"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding FindCommand}">
                    <StackPanel>
                        <TextBlock Text="&#x1F50D;" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="Find" />
                    </StackPanel>
                </Button>
                <Button x:Name="PrintButton"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding PrintCommand}">
                    <StackPanel>
                        <TextBlock Text="&#x1F5A8;" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="Print" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             ROW 1 — Main content: left filter panel + right work area
        ════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left filter panel -->
                <ColumnDefinition Width="230" />
                <!-- Splitter -->
                <ColumnDefinition Width="4" />
                <!-- Right work area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Left filter panel ──────────────────────────────────────── -->
            <Grid Grid.Column="0" Background="#F0F0F0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Panel header -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                    <TextBlock Text="Transfer filter data" Foreground="White" FontWeight="SemiBold" />
                </Border>

                <!-- Filter fields -->
                <Grid Grid.Row="1" Margin="6,8,6,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Transfer type" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              x:Name="TransferTypeComboBox"
                              Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding TransferTypes}"
                              SelectedItem="{Binding SelectedTransferType}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Transfer period" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              x:Name="TransferPeriodComboBox"
                              Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding TransferPeriods}"
                              SelectedItem="{Binding SelectedTransferPeriod}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Transfer status" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              x:Name="TransferStatusComboBox"
                              Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding TransferStatuses}"
                              SelectedItem="{Binding SelectedTransferStatus}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Status to" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              x:Name="StatusToComboBox"
                              Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding StatusToOptions}"
                              SelectedItem="{Binding SelectedStatusTo}" />

                    <Button Grid.Row="4" Grid.Column="1"
                            x:Name="RefreshButton"
                            Content="Refresh"
                            Height="24" Width="70"
                            HorizontalAlignment="Left"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <!-- Transfer group tree/list -->
                <ListBox Grid.Row="2"
                         x:Name="TransferGroupList"
                         Margin="6,0,6,6"
                         BorderBrush="#AAAAAA"
                         ItemsSource="{Binding TransferGroups}"
                         SelectedItem="{Binding SelectedTransferGroup}"
                         DisplayMemberPath="DisplayName"
                         Background="White" />
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#CCCCCC" />

            <!-- ── Right work area ────────────────────────────────────────── -->
            <Grid Grid.Column="2" Margin="6,4,6,4">
                <Grid.RowDefinitions>
                    <!-- Voucher header form -->
                    <RowDefinition Height="Auto" />
                    <!-- Voucher number row -->
                    <RowDefinition Height="Auto" />
                    <!-- Line items DataGrid -->
                    <RowDefinition Height="*" />
                    <!-- Footer summary -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── Voucher header GroupBox ──────────────────────────── -->
                <GroupBox Grid.Row="0"
                          Header="Voucher data"
                          Style="{StaticResource SectionGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Left form column -->
                            <ColumnDefinition Width="*" />
                            <!-- Right form column -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left column -->
                        <Grid Grid.Column="0" Margin="0,4,12,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Supplier type" Style="{StaticResource FormLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                      x:Name="SupplierTypeComboBox"
                                      Style="{StaticResource FormComboBox}"
                                      ItemsSource="{Binding SupplierTypes}"
                                      SelectedItem="{Binding SelectedSupplierType}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Supplier No." Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     x:Name="SupplierNoTextBox"
                                     Style="{StaticResource ReadOnlyTextBox}"
                                     Text="{Binding SupplierNo}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Currency ID" Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     x:Name="CurrencyIdTextBox"
                                     Style="{StaticResource FormTextBox}"
                                     Text="{Binding CurrencyId}" />
                            <TextBox Grid.Row="2" Grid.Column="2"
                                     x:Name="CurrencyCodeTextBox"
                                     Style="{StaticResource FormTextBox}"
                                     Margin="4,0,0,0"
                                     Text="{Binding CurrencyCode}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Exchange rate" Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                     x:Name="ExchangeRateTextBox"
                                     Style="{StaticResource FormTextBox}"
                                     Text="{Binding ExchangeRate, StringFormat=N4}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Specifications" Style="{StaticResource FormLabel}" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="NetAmountRadio"
                                             Content="Net amount"
                                             IsChecked="{Binding IsNetAmount}"
                                             Margin="0,0,12,0" />
                                <RadioButton x:Name="GrossRadio"
                                             Content="Gross"
                                             IsChecked="{Binding IsGross}" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Final posting" Style="{StaticResource FormLabel}" />
                            <CheckBox Grid.Row="5" Grid.Column="1"
                                      x:Name="FinalPostingCheckBox"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding FinalPosting}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Sort number" Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                     x:Name="SortNumberTextBox"
                                     Style="{StaticResource FormTextBox}"
                                     Text="{Binding SortNumber}" />
                        </Grid>

                        <!-- Right column -->
                        <Grid Grid.Column="1" Margin="12,4,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Number Name" Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     x:Name="NumberNameTextBox"
                                     Style="{StaticResource FormTextBox}"
                                     Text="{Binding NumberName}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Issue date" Style="{StaticResource FormLabel}" />
                            <DatePicker Grid.Row="1" Grid.Column="1"
                                        x:Name="IssueDatePicker"
                                        Height="22"
                                        SelectedDate="{Binding IssueDate}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Entry" Style="{StaticResource FormLabel}" />
                            <DatePicker Grid.Row="2" Grid.Column="1"
                                        x:Name="EntryDatePicker"
                                        Height="22"
                                        SelectedDate="{Binding EntryDate}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Amount SC" Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     x:Name="AmountScTextBox"
                                     Style="{StaticResource FormTextBox}"
                                     Text="{Binding AmountSc, StringFormat=N2}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Amount FC" Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     x:Name="AmountFcTextBox"
                                     Style="{StaticResource FormTextBox}"
                                     Text="{Binding AmountFc, StringFormat=N2}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Telephone" Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     x:Name="TelephoneTextBox"
                                     Style="{StaticResource FormTextBox}"
                                     Text="{Binding Telephone}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="No. of positions" Style="{StaticResource FormLabel}" />
                            <TextBox Grid.Row="6" Grid.Column="1"
                                     x:Name="NumberOfPositionsTextBox"
                                     Style="{StaticResource ReadOnlyTextBox}"
                                     Text="{Binding NumberOfPositions}" />
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- VAT note banner -->
                <Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Background="#FFF8DC" BorderBrush="#CCAA00" BorderThickness="1"
                        Padding="6,2" Margin="0,0,0,-20">
                    <TextBlock x:Name="VatEditionNoteText"
                               Text="{Binding VatEditionNote}"
                               FontStyle="Italic"
                               Foreground="#666600" />
                </Border>

                <!-- ── Voucher number row ───────────────────────────────── -->
                <GroupBox Grid.Row="1"
                          Header="Voucher number"
                          Style="{StaticResource SectionGroupBox}"
                          Margin="0,24,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Voucher No." Style="{StaticResource FormLabel}" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1"
                                 x:Name="VoucherNumberTextBox"
                                 Style="{StaticResource FormTextBox}"
                                 Text="{Binding VoucherNumber}" />

                        <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource FormLabel}" Margin="12,0,6,0" />
                        <TextBox Grid.Column="3"
                                 x:Name="VoucherNameTextBox"
                                 Style="{StaticResource FormTextBox}"
                                 Text="{Binding VoucherName}" />
                    </Grid>
                </GroupBox>

                <!-- ── Line items DataGrid ─────────────────────────────── -->
                <DataGrid Grid.Row="2"
                          x:Name="LineItemsGrid"
                          Margin="0,4,0,0"
                          ItemsSource="{Binding LineItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="22"
                          FontSize="12"
                          BorderBrush="#AAAAAA"
                          BorderThickness="1"
                          AlternatingRowBackground="#F8F8F8">

                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header=""
                                                Binding="{Binding Selected}"
                                                Width="30" />
                        <DataGridTextColumn Header="Position"
                                            Binding="{Binding Position}"
                                            Width="70" />
                        <DataGridTextColumn Header="Account No."
                                            Binding="{Binding AccountNo}"
                                            Width="100" />
                        <DataGridTextColumn Header="Account Name"
                                            Binding="{Binding AccountName}"
                                            Width="*" />
                        <DataGridTextColumn Header="Cost Centre"
                                            Binding="{Binding CostCenter}"
                                            Width="100" />
                        <DataGridTextColumn Header="Tax Code"
                                            Binding="{Binding TaxCode}"
                                            Width="80" />
                        <DataGridTextColumn Header="Amount SC"
                                            Binding="{Binding AmountSc, StringFormat=N2}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Margin" Value="0,0,4,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Amount FC"
                                            Binding="{Binding AmountFc, StringFormat=N2}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Margin" Value="0,0,4,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Text"
                                            Binding="{Binding Text}"
                                            Width="*" />
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ── Footer summary ──────────────────────────────────── -->
                <Border Grid.Row="3"
                        BorderBrush="#AAAAAA"
                        BorderThickness="1"
                        Background="#F5F5F5"
                        Padding="6,4"
                        Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Open amount" Style="{StaticResource FormLabel}" />
                        <TextBox Grid.Column="1"
                                 x:Name="OpenAmountTextBox"
                                 Style="{StaticResource ReadOnlyTextBox}"
                                 Text="{Binding OpenAmount, StringFormat=N2}" />

                        <TextBlock Grid.Column="2" Text="Main open amount ID" Style="{StaticResource FormLabel}" Margin="8,0,6,0" />
                        <TextBox Grid.Column="3"
                                 x:Name="MainOpenAmountIdTextBox"
                                 Style="{StaticResource ReadOnlyTextBox}"
                                 Text="{Binding MainOpenAmountId}" />

                        <TextBlock Grid.Column="4" Text="Additional status" Style="{StaticResource FormLabel}" Margin="8,0,6,0" />
                        <TextBox Grid.Column="5"
                                 x:Name="AdditionalStatusTextBox"
                                 Style="{StaticResource ReadOnlyTextBox}"
                                 Text="{Binding AdditionalStatus}" />

                        <TextBlock Grid.Column="6" Text="Customer receipt no." Style="{StaticResource FormLabel}" Margin="8,0,6,0" />
                        <TextBox Grid.Column="7"
                                 x:Name="CustomerReceiptNoTextBox"
                                 Style="{StaticResource FormTextBox}"
                                 Text="{Binding CustomerReceiptNo}" />
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             ROW 2 — Status bar
        ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#E0E0E0" BorderBrush="#AAAAAA" BorderThickness="0,1,0,0">
            <DockPanel Margin="4,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PartialPostingButton"
                            Content="Partial Posting"
                            Style="{StaticResource StatusBarButton}"
                            Command="{Binding PartialPostingCommand}" />
                    <Button x:Name="PrintStatusButton"
                            Content="Print"
                            Style="{StaticResource StatusBarButton}"
                            Command="{Binding PrintCommand}" />
                    <Button x:Name="ReleaseButton"
                            Content="Release"
                            Style="{StaticResource StatusBarButton}"
                            Command="{Binding ReleaseCommand}" />
                    <Button x:Name="CloseButton"
                            Content="Close"
                            Style="{StaticResource StatusBarButton}"
                            Command="{Binding CloseCommand}" />
                    <Button x:Name="DeleteStatusButton"
                            Content="Delete"
                            Style="{StaticResource StatusBarButton}"
                            Command="{Binding DeleteCommand}" />
                    <Button x:Name="SaveDataButton"
                            Content="Save data work"
                            Style="{StaticResource StatusBarButton}"
                            Command="{Binding SaveCommand}" />
                    <Button x:Name="HelpButton"
                            Content="Help"
                            Style="{StaticResource StatusBarButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
